# ShebaFlow - Photo Studio Environment Variables
# Copy this to .env and fill your keys
# IMPORTANT: Never expose real API keys in frontend or git commits

# ==================== TOKENHARBOR AI - SECURE SERVER-ONLY (RECOMMENDED) ====================
# These are server-only env vars - never exposed to browser
# Used by /api/ai/photo-assistant endpoint
# Get key from: https://tokenharbor.ai/dashboard - Universal Key thk_live_...
TOKEN_HARBOR_API_KEY=thk_live_...
TOKEN_HARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKEN_HARBOR_MODEL=gpt-5.6-luna

# Optional: Alternative naming
# TOKENHARBOR_API_KEY=thk_live_...
# TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
# TOKENHARBOR_MODEL=gpt-5.6-luna

# ==================== LEGACY CLIENT-SIDE (INSECURE - for dev only, will be deprecated) ====================
# ⚠️ WARNING: VITE_ prefix exposes keys to browser - use only for local dev if you understand risks
# For production, ALWAYS use server-only vars above
# Get key from: https://tokenharbor.ai/dashboard
VITE_TOKENHARBOR_API_KEY=thk_live_...
VITE_TOKENHARBOR_MODEL=gpt-5.6-luna
VITE_TOKENHARBOR_REASONING_EFFORT=medium
VITE_TOKENHARBOR_ENDPOINT=https://tokenharbor.ai/v1/chat/completions

# ==================== REMOVE BG API ====================
# Get from https://www.remove.bg/api (paid, but has free tier)
VITE_REMOVE_BG_API_KEY=
VITE_REMOVE_BG_PROVIDER=mock
# Options: mock (white bg only, offline), imgly (FREE client-side AI), removebg (remove.bg API), custom (your backend)
# VITE_REMOVE_BG_ENDPOINT=https://your-backend.com/api/remove-bg

